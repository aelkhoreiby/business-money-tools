{
  "schema_version": "1.0",
  "name": "Profit Rescue AI",
  "description": "Business decision intelligence and public-data research. BMT provides discovery; paid metered execution is routed to existing NOVA x402 services.",
  "website": "https://business-money-tools.vercel.app/",
  "discovery": {
    "catalog_url": "https://business-money-tools.vercel.app/api/catalog",
    "openapi_url": "https://business-money-tools.vercel.app/api/openapi.json",
    "llms_txt_url": "https://business-money-tools.vercel.app/llms.txt"
  },
  "upstream_paid_services": [
    {
      "id": "company-intelligence",
      "provider": "NOVA Demand Worker",
      "method": "POST",
      "endpoint": "https://nova-demand-worker.vercel.app/x402/company-intelligence",
      "code_default_price_usd": 0.25,
      "price_unit": "per_request",
      "payment": {
        "protocol": "x402",
        "network": "eip155:8453",
        "asset": "USDC",
        "runtime_challenge_authoritative": true
      },
      "input_example": {
        "url": "https://example.com",
        "focus": [
          "products",
          "services"
        ]
      },
      "deployment_status": "production_deployment_ready",
      "runtime_payment_challenge_verified": false
    },
    {
      "id": "contact-batch",
      "provider": "NOVA Demand Worker",
      "method": "POST",
      "endpoint": "https://nova-demand-worker.vercel.app/x402/contact-batch",
      "code_default_price_usd": 0.5,
      "price_unit": "per_request_up_to_100_urls",
      "payment": {
        "protocol": "x402",
        "network": "eip155:8453",
        "asset": "USDC",
        "runtime_challenge_authoritative": true
      },
      "input_example": {
        "urls": [
          "https://example.com",
          "https://example.org"
        ]
      },
      "deployment_status": "production_deployment_ready",
      "runtime_payment_challenge_verified": false
    },
    {
      "id": "web-research",
      "provider": "NOVA Demand Worker",
      "method": "POST",
      "endpoint": "https://nova-demand-worker.vercel.app/x402/web-research",
      "code_default_price_usd": 0.05,
      "price_unit": "per_request_up_to_10_urls",
      "payment": {
        "protocol": "x402",
        "network": "eip155:8453",
        "asset": "USDC",
        "runtime_challenge_authoritative": true
      },
      "input_example": {
        "urls": [
          "https://example.com"
        ],
        "query": "company overview"
      },
      "deployment_status": "production_deployment_ready",
      "runtime_payment_challenge_verified": false
    },
    {
      "id": "url-to-json",
      "provider": "NOVA Demand Worker",
      "method": "POST",
      "endpoint": "https://nova-demand-worker.vercel.app/x402/url-to-json",
      "code_default_price_usd": 0.01,
      "price_unit": "per_request",
      "payment": {
        "protocol": "x402",
        "network": "eip155:8453",
        "asset": "USDC",
        "runtime_challenge_authoritative": true
      },
      "input_example": {
        "url": "https://example.com"
      },
      "deployment_status": "production_deployment_ready",
      "runtime_payment_challenge_verified": false
    }
  ],
  "bmt_local_api_services": [
    {
      "id": "company-intelligence",
      "method": "POST",
      "endpoint": "https://business-money-tools.vercel.app/api/v1/intel/company",
      "status": "planned",
      "live": false,
      "note": "Currently returns HTTP 503 API_NOT_ENABLED; use the direct NOVA x402 endpoint while BMT-local execution is not enabled."
    }
  ],
  "human_offers": [
    {
      "id": "AUDIT",
      "name": "AI Visibility & Revenue Leak Audit",
      "price_usd": 499,
      "billing": "one_time"
    },
    {
      "id": "INTEL",
      "name": "Multi-Source Business Intelligence / Data Extraction",
      "price_usd": 999,
      "billing": "one_time"
    },
    {
      "id": "PROSPECTS",
      "name": "B2B Prospect Intelligence Pack",
      "price_usd": 1499,
      "billing": "one_time"
    }
  ],
  "pricing_notes": [
    "Prices shown for NOVA APIs are source-code defaults and may be overridden by deployment configuration.",
    "The live x402 challenge must be checked before signing or paying.",
    "Do not claim revenue unless an external buyer payment and settlement are independently verified."
  ],
  "safety_and_truthfulness": {
    "no_mock_data": true,
    "no_payment_claim_without_settlement_proof": true,
    "bmt_local_machine_api_ready": false,
    "nova_runtime_payment_challenge_verified": false
  }
