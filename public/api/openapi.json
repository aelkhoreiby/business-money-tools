{
  "openapi": "3.1.0",
  "info": {
    "title": "Profit Rescue AI Discovery and NOVA Machine APIs",
    "version": "0.2.0",
    "description": "BMT discovery/catalog plus direct x402 routes in the NOVA production deployment. Prices below are code defaults only; runtime x402 payment requirements are authoritative. BMT's own company-intelligence endpoint is planned and intentionally unavailable."
  },
  "servers": [
    {
      "url": "https://business-money-tools.vercel.app",
      "description": "BMT discovery and catalog"
    }
  ],
  "paths": {
    "/api/catalog": {
      "get": {
        "operationId": "getMachineServiceCatalog",
        "summary": "Get human offers and machine-service discovery",
        "responses": {
          "200": {
            "description": "Current machine-readable catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/intel/company": {
      "post": {
        "operationId": "bmtLocalCompanyIntelligence",
        "summary": "BMT-local company intelligence (planned; not enabled)",
        "description": "Returns HTTP 503 API_NOT_ENABLED until BMT-local execution and payment are connected. Use the direct NOVA x402 endpoint instead.",
        "x-lifecycle": "planned",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "domains"
                ],
                "properties": {
                  "domains": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "format": "hostname"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "503": {
            "description": "BMT-local API is not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": false
                    },
                    "error_code": {
                      "type": "string",
                      "const": "API_NOT_ENABLED"
                    },
                    "charge_incurred": {
                      "type": "boolean",
                      "const": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/x402/company-intelligence": {
      "post": {
        "servers": [
          {
            "url": "https://nova-demand-worker.vercel.app",
            "description": "NOVA upstream x402 endpoint"
          }
        ],
        "operationId": "novaCompanyIntelligence",
        "summary": "Source-backed company profile for one public business website",
        "description": "Uses NOVA's x402-protected route. Use an x402-capable client; the live payment challenge—not the listed code default—sets the required amount.",
        "x-payment-info": {
          "protocol": "x402",
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "code_default_price_usd": 0.25,
          "price_unit": "per_request",
          "runtime_challenge_authoritative": true
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Public HTTP or HTTPS business website URL"
                  },
                  "focus": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Company intelligence JSON returned after successful execution and payment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "402": {
            "description": "x402 payment challenge; verify amount, network, and asset before signing"
          },
          "422": {
            "description": "The requested source operation failed"
          },
          "503": {
            "description": "Payment service temporarily unavailable"
          }
        }
      }
    },
    "/x402/contact-batch": {
      "post": {
        "servers": [
          {
            "url": "https://nova-demand-worker.vercel.app",
            "description": "NOVA upstream x402 endpoint"
          }
        ],
        "operationId": "novaContactBatch",
        "summary": "Extract public business contacts from 1–100 public websites",
        "description": "One x402 request covers the submitted batch, up to 100 URLs. The live challenge defines the actual price.",
        "x-payment-info": {
          "protocol": "x402",
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "code_default_price_usd": 0.5,
          "price_unit": "per_request_up_to_100_urls",
          "runtime_challenge_authoritative": true
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "urls"
                ],
                "properties": {
                  "urls": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured public-contact batch result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "402": {
            "description": "x402 payment challenge; verify amount, network, and asset before signing"
          },
          "422": {
            "description": "The requested source operation failed"
          },
          "503": {
            "description": "Payment service temporarily unavailable"
          }
        }
      }
    },
    "/x402/web-research": {
      "post": {
        "servers": [
          {
            "url": "https://nova-demand-worker.vercel.app",
            "description": "NOVA upstream x402 endpoint"
          }
        ],
        "operationId": "novaWebResearch",
        "summary": "Rank evidence from up to 10 public web pages",
        "description": "Uses NOVA's x402-protected route. Price shown is the source-code default; inspect the live challenge before paying.",
        "x-payment-info": {
          "protocol": "x402",
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "code_default_price_usd": 0.05,
          "price_unit": "per_request",
          "runtime_challenge_authoritative": true
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "urls"
                ],
                "properties": {
                  "urls": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evidence-ranked research JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "402": {
            "description": "x402 payment challenge; verify amount, network, and asset before signing"
          },
          "422": {
            "description": "The requested source operation failed"
          },
          "503": {
            "description": "Payment service temporarily unavailable"
          }
        }
      }
    },
    "/x402/url-to-json": {
      "post": {
        "servers": [
          {
            "url": "https://nova-demand-worker.vercel.app",
            "description": "NOVA upstream x402 endpoint"
          }
        ],
        "operationId": "novaUrlToJson",
        "summary": "Extract structured JSON from one public web page",
        "description": "Uses NOVA's x402-protected route. Price shown is the source-code default; inspect the live challenge before paying.",
        "x-payment-info": {
          "protocol": "x402",
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "code_default_price_usd": 0.01,
          "price_unit": "per_request",
          "runtime_challenge_authoritative": true
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured page JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "402": {
            "description": "x402 payment challenge; verify amount, network, and asset before signing"
          },
          "422": {
            "description": "The requested source operation failed"
          },
          "503": {
            "description": "Payment service temporarily unavailable"
          }
        }
      }
    }
  }
}
